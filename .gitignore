.env
.venv

# Sample media under data/ is tracked and ships with the repository.
# data/*
# !data/README.md

.DS_Store
**/.DS_Store
**/.*.DS_Store*
.!*

# Rust build
**/target/
# Shared-target Cargo lock beside the default target/ (scripts/lib/cargo_shared.sh)
**/target.lock
# Tauri generated schemas (rebuilt by tauri-build on every build)
apps/filesquid/crates/desktop/gen/schemas/
# FileSquid host data (activity journal, admin token) and journal exports from local runs
**/filesquid-data/
*.jsonl

# Test reports & artifacts
**/artifacts/
**/playwright-report/
**/allure-results/
**/coverage/
**/wdio-logs/
**/docs-jsdoc/

# Dependency directories
node_modules/
**/node_modules/

# Scratch files and transient tests
**/test-card.js
**/screenshot.spec.js

# Allow selective tracking in tests/
**/tests/*
!**/tests/features/
!**/tests/support/
!**/tests/unit/
!**/tests/ui/
!**/tests/e2e/
!**/tests/integration/
!**/tests/performance/
# Gherkin of a harness that needs a Cargo feature (filesquid-native `desktop`).
!**/tests/catalog_features/
# Pinned third-party test data, such as the OCFL community fixtures (OCFL-S-011).
!**/tests/fixtures/
!**/tests/README.md
!**/tests/**/*.rs
!**/tests/**/*.ts
!**/tests/**/*.spec.ts
!**/tests/**/*.feature
!**/tests/**/.gitkeep


# Playwright last-run
**/test-results/


# Local Compose service data (postgres, elasticsearch, optional observability sinks)
data/*_data/

# Python bytecode caches
**/__pycache__/
*.pyc

# Claude Code worktrees for parallel agent runs
.claude/worktrees/
