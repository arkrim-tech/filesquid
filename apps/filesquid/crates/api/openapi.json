{
  "openapi": "3.1.0",
  "info": {
    "title": "FileSquid API",
    "version": "0.7.0",
    "description": "The single FileSquid API served by every FileSquid host. See resources/architecture/030-filesquid-api-and-transports.md. Conventions: a command (mutation) sends a CommandEnvelope as the `envelope` member of its JSON request body (operation_id is the idempotency key, expected_revision the revision last read) and answers with a CommandOutcome; a query (list) takes the PageSize (`limit`, 1-1000) and Cursor (`cursor`) parameters; every failed request answers with an ApiError body (code, message, retryable). Router-wide fallbacks: any /api/v1/ path not in this contract answers 404 not_found, and a documented path called with a method it does not document answers 405 method_not_allowed; both carry the ApiError body. They are not listed per operation because no operation sends them. Authorisation is deny-by-default: every operation, including health, the contract and the event channel, requires the bearerAuth credential and is authorised before anything else runs, so a call without it answers 401 unauthorized and a call whose credential is not accepted or does not grant the operation answers 403 forbidden, before any 404 or 405; both carry the ApiError body with a DenialReason in `reason`. Each operation names the authorisation action it performs in x-filesquid-action. The one deliberate exception is GET /api/v1/health/live (x-filesquid-action public, security []), a liveness probe that answers only {\"status\":\"up\"} without a credential. Paths marked x-filesquid-host-route are served by the hosts, not by the filesquid-api router."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Process health",
        "x-filesquid-action": "health.read",
        "responses": {
          "200": {
            "description": "The host is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Liveness probe: the process is up (public, no credential)",
        "x-filesquid-action": "public",
        "security": [],
        "description": "Deliberately public so process supervisors and load balancers can probe without a token. Answers only that the process is up: no version, no component detail, no journal. Full health is GET /api/v1/health, which needs the bearerAuth credential.",
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getContract",
        "summary": "This API contract",
        "x-filesquid-action": "contract.read",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document.",
            "content": {
              "application/json": {}
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/host": {
      "get": {
        "operationId": "getHost",
        "summary": "Host descriptor: host type, operator name and hosted backup and sync state",
        "description": "Which host this API runs on (host_type, supplied by the host when it starts, never derived from the request), who operates it (operator_name, a server's FILESQUID_OPERATOR_NAME; null on desktop and browser hosts and on an unnamed server) and the state of encrypted backup and sync to the ciphertext-only hosted service (hosted_service; backup and sync are reported separately because they are distinct guarantees). Every caller the host authenticates may read it (action host.read is granted to every accepted credential, not to administrators only); it is never public. A host.change event carries the whole new descriptor whenever a field changes; a client MUST read this route again after events.resync or a reconnect. A successful read is not journaled. The descriptor carries no token, content handle, key or key identifier, account or device identifier, e-mail address, quota, object count, size, timestamp, path or file name.",
        "x-filesquid-action": "host.read",
        "responses": {
          "200": {
            "description": "The host descriptor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostDescriptor"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/HostNotDescribed"
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "operationId": "subscribeEvents",
        "summary": "Push events (WebSocket on filesquid-server; Tauri events named filesquid-event on filesquid-desktop).",
        "x-filesquid-action": "events.subscribe",
        "responses": {
          "101": {
            "description": "Switching protocols to WebSocket. Each text frame is one ApiEvent."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "description": "One event channel for job progress and change notifications. Each event is an ApiEvent whose topic is an EventTopic; x-filesquid-event-payloads names the payload schema of each topic. Events are hints, not state: a client MUST NOT depend on receiving every event. A subscriber that falls more than 256 events behind, or whose next event encodes to more than 65536 bytes, receives one events.resync event (EventResync) instead of the events it missed and MUST reread the state it shows through the request routes; a client that reconnects MUST do the same. At most 64 subscribers are served at once. Authorisation: send Authorization: Bearer <token>; a browser, which cannot set headers on a WebSocket, offers the subprotocols filesquid.events.v1 and filesquid.bearer.<token> instead, and the server selects filesquid.events.v1. A refused upgrade answers 401 or 403 with an ApiError body instead of switching protocols."
      },
      "x-filesquid-host-route": true,
      "x-filesquid-event-payloads": {
        "process.update": {
          "$ref": "#/components/schemas/ProcessView"
        },
        "journal.entry": {
          "$ref": "#/components/schemas/JournalEntry"
        },
        "health.change": {
          "$ref": "#/components/schemas/HealthReport"
        },
        "events.resync": {
          "$ref": "#/components/schemas/EventResync"
        },
        "host.change": {
          "$ref": "#/components/schemas/HostDescriptor"
        }
      }
    },
    "/api/v1/admin/health": {
      "get": {
        "operationId": "getAdminHealth",
        "summary": "Overall health with reasons",
        "x-filesquid-action": "monitor.read",
        "responses": {
          "200": {
            "description": "Health report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/admin/processes": {
      "get": {
        "operationId": "getAdminProcesses",
        "summary": "Live and recently finished processes",
        "x-filesquid-action": "monitor.read",
        "responses": {
          "200": {
            "description": "Processes in registration order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProcessView"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/admin/journal": {
      "get": {
        "operationId": "getAdminJournal",
        "summary": "Search the activity journal",
        "x-filesquid-action": "monitor.read",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Earliest time, RFC 3339 (inclusive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Latest time, RFC 3339 (inclusive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "in": "query",
            "required": false,
            "description": "Exact actor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "Exact operation, for example ocfl.commit.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "required": false,
            "description": "Exact outcome.",
            "schema": {
              "$ref": "#/components/schemas/Outcome"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "Exact level.",
            "schema": {
              "$ref": "#/components/schemas/Level"
            }
          },
          {
            "name": "process",
            "in": "query",
            "required": false,
            "description": "Exact process id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Cursor: entries with a greater id.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "asc (default) or desc (newest first).",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JournalPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/admin/journal/export": {
      "get": {
        "operationId": "exportAdminJournal",
        "summary": "Export matching journal entries as JSON Lines",
        "x-filesquid-action": "monitor.read",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Earliest time, RFC 3339 (inclusive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Latest time, RFC 3339 (inclusive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor",
            "in": "query",
            "required": false,
            "description": "Exact actor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "Exact operation, for example ocfl.commit.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "required": false,
            "description": "Exact outcome.",
            "schema": {
              "$ref": "#/components/schemas/Outcome"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "Exact level.",
            "schema": {
              "$ref": "#/components/schemas/Level"
            }
          },
          {
            "name": "process",
            "in": "query",
            "required": false,
            "description": "Exact process id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Continue after this entry id (the value of X-Journal-Next-Cursor from a truncated export).",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One JournalEntry per line. At most 1 000 000 entries per response; when more match, X-Journal-Next-Cursor is set.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "X-Journal-Next-Cursor": {
                "description": "Present only when the export stopped at its size cap with more entries left; pass it as `after` to continue.",
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/v1/admin/metrics": {
      "get": {
        "operationId": "getAdminMetrics",
        "summary": "Counters and gauges (same values as /metrics)",
        "x-filesquid-action": "monitor.read",
        "responses": {
          "200": {
            "description": "Metric name to value.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiEvent": {
        "type": "object",
        "required": [
          "topic",
          "data"
        ],
        "properties": {
          "topic": {
            "$ref": "#/components/schemas/EventTopic"
          },
          "data": {
            "description": "Topic-specific payload; see x-filesquid-event-payloads on /api/v1/events."
          }
        },
        "description": "One push event on the event channel: a topic and that topic's payload."
      },
      "EventTopic": {
        "type": "string",
        "enum": [
          "process.update",
          "journal.entry",
          "health.change",
          "events.resync",
          "host.change"
        ],
        "description": "Documented event topics: process.update (a process or job changed), journal.entry (an activity journal entry was written), health.change (the health status changed), events.resync (events were missed; reread state), host.change (a host descriptor field changed; the payload is the whole new HostDescriptor; reread GET /api/v1/host after events.resync or a reconnect)."
      },
      "EventResync": {
        "type": "object",
        "required": [
          "missed"
        ],
        "properties": {
          "missed": {
            "type": "integer",
            "minimum": 1,
            "description": "How many events this subscriber did not receive."
          }
        },
        "description": "Payload of events.resync: the subscriber missed events and MUST reread the state it shows."
      },
      "Level": {
        "type": "string",
        "enum": [
          "info",
          "warn",
          "error"
        ]
      },
      "Outcome": {
        "type": "string",
        "enum": [
          "info",
          "started",
          "succeeded",
          "failed",
          "stalled",
          "resumed",
          "cancelled"
        ]
      },
      "JournalEntry": {
        "type": "object",
        "required": [
          "time",
          "host",
          "actor",
          "operation",
          "outcome",
          "level",
          "target_ids"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "host": {
            "type": "string"
          },
          "process_id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/Outcome"
          },
          "level": {
            "$ref": "#/components/schemas/Level"
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_ms": {
            "type": "integer"
          },
          "error_code": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "description": "Opaque operation ID shared by every entry and OCFL version of one operation (ADR 040)."
          },
          "object_ref": {
            "type": "string",
            "description": "OCFL object version the entry is about: `<object-id>@vN`."
          }
        }
      },
      "JournalPage": {
        "type": "object",
        "required": [
          "entries",
          "next_cursor"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JournalEntry"
            }
          },
          "next_cursor": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "ProcessState": {
        "type": "string",
        "enum": [
          "running",
          "stalled",
          "completed",
          "failed",
          "cancelled"
        ]
      },
      "ProcessView": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "state",
          "done",
          "total",
          "started",
          "last_heartbeat",
          "heartbeat_timeout_ms",
          "rate_per_second",
          "eta_seconds",
          "error_code"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ProcessState"
          },
          "done": {
            "type": "integer"
          },
          "total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "started": {
            "type": "string",
            "format": "date-time"
          },
          "last_heartbeat": {
            "type": "string",
            "format": "date-time"
          },
          "heartbeat_timeout_ms": {
            "type": "integer"
          },
          "rate_per_second": {
            "type": [
              "number",
              "null"
            ]
          },
          "eta_seconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HealthReason": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/MonitorStatus"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "HealthInputs": {
        "type": "object",
        "required": [
          "stalled",
          "store_ok",
          "data_dir_writable",
          "free_bytes",
          "queue_fill",
          "errors_last_5m"
        ],
        "properties": {
          "stalled": {
            "type": "integer"
          },
          "store_ok": {
            "type": "boolean"
          },
          "data_dir_writable": {
            "type": "boolean"
          },
          "free_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "queue_fill": {
            "type": "number"
          },
          "errors_last_5m": {
            "type": "integer"
          }
        }
      },
      "HealthReport": {
        "type": "object",
        "required": [
          "status",
          "reasons",
          "checks"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/MonitorStatus"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthReason"
            }
          },
          "checks": {
            "$ref": "#/components/schemas/HealthInputs"
          }
        }
      },
      "MonitorStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "failing"
        ]
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "schema_version",
          "status",
          "product"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "status": {
            "type": "string",
            "const": "ok"
          },
          "product": {
            "type": "string"
          }
        }
      },
      "Liveness": {
        "type": "object",
        "description": "Body of the public liveness probe. Says only that the process is up.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable error code. HTTP status: invalid_request 400, unauthorized 401, forbidden 403, not_found 404, method_not_allowed 405, conflict 409, internal 500, unavailable 503. Only unavailable is retryable. The router-wide fallbacks use 404 not_found (path not in the contract) and 405 method_not_allowed (method not documented for the path).",
        "enum": [
          "invalid_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "conflict",
          "internal",
          "unavailable"
        ]
      },
      "DenialReason": {
        "type": "string",
        "description": "Why the authorisation layer refused a call: missing_credentials (401 unauthorized), invalid_credentials (403 forbidden: the credential is not accepted by this host) or not_permitted (403 forbidden: the caller is known but may not perform this operation). Never retryable.",
        "enum": [
          "missing_credentials",
          "invalid_credentials",
          "not_permitted"
        ]
      },
      "ApiError": {
        "type": "object",
        "description": "Body of every failed API request. Authorisation denials (401 unauthorized, 403 forbidden) also carry `reason`.",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "description": "Human-readable message the UI can show. Never contains paths, SQL or internal error text."
          },
          "retryable": {
            "type": "boolean",
            "description": "True when repeating the same request unchanged may succeed."
          },
          "reason": {
            "$ref": "#/components/schemas/DenialReason"
          }
        }
      },
      "PortError": {
        "type": "object",
        "description": "Error reported by a module port, with retryability (CORE-S-005).",
        "required": [
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Module error code."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether the caller MAY retry."
          }
        }
      },
      "CommandEnvelope": {
        "type": "object",
        "description": "Versioned envelope every command (mutation) carries (CORE-S-005).",
        "required": [
          "schema_version",
          "operation_id",
          "expected_revision",
          "scope"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "description": "Protocol schema version."
          },
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "description": "Operation and idempotency key: repeating a command with the same id MUST NOT apply it twice."
          },
          "expected_revision": {
            "type": "string",
            "minLength": 1,
            "description": "Revision the caller last read; a mismatch answers conflict."
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "description": "Permitted scope, for example library:<id>."
          }
        }
      },
      "QueryEnvelope": {
        "type": "object",
        "description": "Versioned envelope every query (list) carries (CORE-S-005).",
        "required": [
          "schema_version",
          "page_size",
          "scope"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "description": "Protocol schema version."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Bounded page size."
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "description": "Permitted scope."
          }
        }
      },
      "CommandOutcomeKind": {
        "type": "string",
        "description": "committed is durable completion evidence; pending is durable but incomplete; conflict means the expected revision did not match; error carries a PortError.",
        "enum": [
          "committed",
          "pending",
          "conflict",
          "error"
        ]
      },
      "CommandOutcome": {
        "type": "object",
        "description": "Result of a command, tied to its operation id.",
        "required": [
          "operation_id",
          "kind",
          "error"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1,
            "description": "The command's operation id."
          },
          "kind": {
            "$ref": "#/components/schemas/CommandOutcomeKind"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PortError"
              },
              {
                "type": "null"
              }
            ],
            "description": "The module error when kind is error, otherwise null."
          }
        }
      },
      "HostType": {
        "type": "string",
        "enum": [
          "desktop",
          "server",
          "browser"
        ],
        "description": "The kind of host the API runs on, supplied by the host itself: desktop (filesquid-desktop), server (filesquid-server, whose operator can read what it stores) or browser (the encrypted browser host)."
      },
      "HostedService": {
        "type": "object",
        "description": "Encrypted backup and sync to the ciphertext-only hosted service. When enrolled is false, backup_enabled and sync_enabled are false and service_host is null. When enrolled is true, service_host is the service's lowercase DNS host name (no scheme, port, path, user information or query) and backup_enabled and sync_enabled are reported separately.",
        "required": [
          "enrolled",
          "backup_enabled",
          "sync_enabled",
          "service_host"
        ],
        "properties": {
          "enrolled": {
            "type": "boolean"
          },
          "backup_enabled": {
            "type": "boolean"
          },
          "sync_enabled": {
            "type": "boolean"
          },
          "service_host": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 253,
            "description": "Lowercase DNS host name of the hosted service, or null when not enrolled."
          }
        },
        "additionalProperties": false
      },
      "HostDescriptor": {
        "type": "object",
        "description": "The answer of GET /api/v1/host and the payload of a host.change event.",
        "required": [
          "schema_version",
          "host_type",
          "operator_name",
          "hosted_service"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "host_type": {
            "$ref": "#/components/schemas/HostType"
          },
          "operator_name": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256,
            "description": "The server operator's display name (trimmed, 1 to 256 characters, no control characters); null on desktop and browser hosts and on a server without FILESQUID_OPERATOR_NAME."
          },
          "hosted_service": {
            "$ref": "#/components/schemas/HostedService"
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "PageSize": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size for a query (1-1000). Each operation states its default; the activity journal defaults to 100.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque cursor from the previous page.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Invalid or malformed request (invalid_request).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No credentials were presented (unauthorized, reason missing_credentials).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The credentials are not accepted (reason invalid_credentials) or do not permit this operation (reason not_permitted).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Internal": {
        "description": "The host failed (internal).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Monitor not started yet (unavailable; retryable).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "HostNotDescribed": {
        "description": "The host has not described itself yet (unavailable; retryable).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Deny-by-default credential required by every operation. filesquid-desktop: the per-launch token the host generates at every launch and gives only to its own webviews (window.__FILESQUID_LAUNCH_TOKEN__). filesquid-server: the administrator token (FILESQUID_ADMIN_TOKEN or <data dir>/admin-token) until accounts, sessions and groups arrive. A WebSocket upgrade may carry it as the subprotocol filesquid.bearer.<token>."
      }
    }
  }
}
