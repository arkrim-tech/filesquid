{
  "name": "@filesquid/desktop-e2e",
  "private": true,
  "description": "Packaged-window tests for filesquid-desktop: WebdriverIO with the Tauri service and the embedded WebDriver provider (ADR 017, ADR 035).",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "pretest:e2e": "node -e \"require('fs').rmSync('../allure-results/wdio', { recursive: true, force: true })\"",
    "test:e2e": "wdio run ./wdio.conf.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@wdio/cli": "9.32.0",
    "@wdio/junit-reporter": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-service": "1.5.0",
    "prettier": "3.9.10",
    "webdriverio": "9.32.0"
  }
}
