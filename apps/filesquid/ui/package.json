{
  "name": "@filesquid/ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "FileSquid UI: API client, custom elements, design tokens and the default Drive-style app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./theme/tokens.css": "./src/theme/tokens.css",
    "./theme/labels.en.json": "./src/theme/labels.en.json"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "pretest": "rm -rf tests/allure-results",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "contract:types": "openapi-typescript ../crates/api/openapi.json -o src/api/schema.d.ts",
    "desktop:dev": "cd ../crates/desktop && tauri dev",
    "desktop:build": "cd ../crates/desktop && tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "~2.12",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12"
  }
}
